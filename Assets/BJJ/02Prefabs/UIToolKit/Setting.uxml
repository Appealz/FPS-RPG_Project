<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/BJJ/02Prefabs/UIToolKit/SettingSlider.uss?fileID=7433441132597879392&amp;guid=e913fdee5ca2c9147b7c6a22f9a16714&amp;type=3#SettingSlider" />
    <ui:VisualElement name="Background" style="flex-grow: 1; background-image: none; background-color: rgb(0, 0, 0);">
        <ui:VisualElement name="Background2" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Asset/Sci-Fi%20UI/_SciFi_GUISkin_/atlas.png?fileID=21300000&amp;guid=56d84991286850f428b4e7df0cca7380&amp;type=3#window&quot;); background-color: rgb(0, 0, 0); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <ui:VisualElement name="TopRight" style="flex-grow: 0.05; background-size: 100% 80%; background-image: none; position: relative; align-self: flex-end; margin-bottom: 0; height: auto; padding-top: 15px; padding-right: 15px; padding-bottom: 0; padding-left: 0; align-content: center; align-items: center;">
                <ui:Button text="Close" name="OptionCloseBtn" class="close-btn" style="align-self: auto; width: 300px; height: 100px; background-image: url(&quot;project://database/Assets/Asset/Sci-Fi%20UI/_SciFi_GUISkin_/atlas.png?fileID=21300014&amp;guid=56d84991286850f428b4e7df0cca7380&amp;type=3#button1&quot;); background-color: rgba(0, 0, 0, 0); font-size: 35px;" />
            </ui:VisualElement>
            <ui:VisualElement name="MiddleCenter" style="flex-grow: 1; background-size: 100% 80%; background-image: none; position: relative; flex-direction: column; padding-top: 25px; padding-right: 25px; padding-bottom: 25px; padding-left: 25px;">
                <ui:VisualElement name="SettingBackground" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Asset/Sci-Fi%20UI/_SciFi_GUISkin_/atlas.png?fileID=21300002&amp;guid=56d84991286850f428b4e7df0cca7380&amp;type=3#window1&quot;); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-direction: row;">
                    <ui:VisualElement name="TopMiddle" style="flex-grow: 1; justify-content: space-evenly;">
                        <ui:Slider label="Master" value="42" high-value="100" name="MasterSlider" language-direction="Inherit" data-source-path="MasterVolume" class="SettingSlider" style="align-items: stretch;" />
                        <ui:Slider label="BGM" value="42" high-value="100" name="BGMSlider" data-source-path="BGMVolume" class="SettingSlider" />
                        <ui:Slider label="SFX" value="42" high-value="100" name="SFXSlider" data-source-path="SFXVolume" class="SettingSlider" />
                        <ui:Slider label="MouseSensitive" value="42" high-value="100" name="MouseSlider" data-source-path="MouseSensitive" class="SettingSlider" style="align-items: stretch;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="TopRight" style="flex-grow: 0.1; justify-content: space-evenly; align-items: center;">
                        <ui:FloatField value="42.2" name="MasterInput" class="SettingInputBox" />
                        <ui:FloatField value="42.2" name="BGMInput" class="SettingInputBox" />
                        <ui:FloatField value="42.2" name="SFXInput" class="SettingInputBox" />
                        <ui:FloatField value="42.2" name="MouseInput" class="SettingInputBox" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
